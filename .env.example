# ================================
# CRM Docker Environment Variables
# ================================
# Copy file ini ke .env dan isi nilainya sebelum menjalankan docker compose

# Database password untuk MySQL
DB_PASSWORD=password

# JWT signing secret — WAJIB diganti di production
JWT_SECRET=change-me-in-production

# URL publik backend (dipakai backend untuk generate URL file upload)
API_BASE_URL=http://localhost:3000

# URL backend yang diakses browser (baked saat frontend build)
# Ganti ke domain/IP production jika deploy ke server
API_URL=http://localhost:3000
